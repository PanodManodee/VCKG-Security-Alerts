NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
# Earliest CVE year to ingest (empty = full corpus, 1999+)
CTI_SINCE_YEAR=

# Wazuh indexer of the lab (lab_env/), read by `python -m alert_kg fetch`
WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=SecretPassword
# Verify the indexer's TLS certificate (leave empty to skip verification in the lab):
# WAZUH_INDEXER_CA=lab_env/wazuh/config/wazuh_indexer_ssl_certs/root-ca.pem
