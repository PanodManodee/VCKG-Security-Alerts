# Copy to .env (lab_env/.env, git-ignored). Dummy credentials for an isolated lab only.
WAZUH_VERSION=4.9.2

# PostgreSQL superuser (postgres) password
POSTGRES_PASSWORD=Passw0rd!

# Files-SMB account for the [finance] share ([public] is guest)
SMB_USER=alice
SMB_PASSWORD=Passw0rd!

# Office workstations (SSH logins)
ADMIN_PC_USER=alice
ADMIN_PC_PASSWORD=Passw0rd!
DEP_PC_USER=bob
DEP_PC_PASSWORD=Passw0rd!

# 1 = lab hosts can reach the real internet through the firewall (off by default)
FW_ALLOW_EGRESS=0
